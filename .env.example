# Copy to .env for local runs (`make run`). Never commit the real file.
# Any NAME can be given as NAME_FILE=/path/to/secret instead (Docker or Kubernetes secrets).

APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=8080
HTTP_CORS_ALLOW_ORIGINS=http://localhost:5173

# PostgreSQL 13+ with the cube and earthdistance extensions (both ship with PostgreSQL).
# The service names its connections "streetfood-customer-api" (pg_stat_activity, Neon console);
# add application_name=… to the URL to use another name. Neon's pooled (-pooler) string works.
PG_URL=
PG_POOL_MAX=10

# Redis is optional. It only carries signals between several instances of this service
# (see README, "Redis"): nothing is stored in it. Leave empty with one instance.
#   from your machine:    redis://localhost:6380/0   (the shared local-dev-redis-1 container)
#   with a password:      redis://:PASSWORD@host:6379/0
#   with TLS (managed):   rediss://:PASSWORD@host:6380/0
REDIS_URL=
# The same Redis as seen from containers (docker compose up): redis://redis:6379/0
DOCKER_REDIS_URL=

# Firebase Authentication: customers sign in with the Firebase SDK; this API only verifies
# their ID tokens for this project.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Operator token for /v1/admin (register merchants). At least 32 random characters:
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# Encrypts merchants' POS secrets at rest. 32 random bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# POS hostnames a merchant may be registered with (https only). localhost is accepted
# outside production for development.
POS_ALLOWED_HOSTS=pos.example.com

# Background workers run when work is created and when a retry or deadline falls due. This is
# the longest they sleep with nothing scheduled, a safety net (1m to 24h). Keep it long on Neon:
# the database suspends after 5 idle minutes, and every sweep wakes it.
WORKER_SWEEP_INTERVAL=1h
# How often each merchant's outlets and menus are re-read from its POS, also a safety net: the
# POS pushes every change.
INTEGRATION_RECONCILE_INTERVAL=1h

# Online payment. The platform's fee is a share of the order total, in basis points (250 = 2.5%):
# the customer pays it on top, the merchant owes it on completion.
FEE_CUSTOMER_BPS=250
FEE_MERCHANT_BPS=250
# How long a customer has to pay an order.
PAYMENT_WINDOW=15m
# This API's public address; shown to merchants as the callback URL for their gateway.
PUBLIC_BASE_URL=https://api.example.com
# Where gateways send customers after paying (an app deep link). Optional.
PAYMENT_RETURN_URL=

METRICS_ENABLED=true
