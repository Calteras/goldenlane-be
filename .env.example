# Copy to .env for local runs (`make run`). Never commit the real file.
# Any NAME can be given as NAME_FILE=/path/to/secret instead (Docker or Kubernetes secrets).

APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=8080
HTTP_CORS_ALLOW_ORIGINS=http://localhost:5173

# PostgreSQL 13+ with the cube and earthdistance extensions (both ship with PostgreSQL).
PG_URL=postgres://postgres:postgres@localhost:5432/streetfood?sslmode=disable
PG_POOL_MAX=10

# Firebase Authentication: customers sign in with the Firebase SDK; this API only verifies
# their ID tokens for this project.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Operator token for /v1/admin (register merchants). At least 32 random characters:
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# Encrypts merchants' POS secrets at rest. 32 random bytes, base64:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# POS hostnames a merchant may be registered with (https only). localhost is accepted
# outside production for development.
POS_ALLOWED_HOSTS=pos.example.com

# How often queued POS events are applied when idle, and how often each merchant's outlets
# and menus are re-read from its POS as a safety net.
INTEGRATION_WORKER_INTERVAL=1s
INTEGRATION_RECONCILE_INTERVAL=15m

# Online payment. The platform's fee is a share of the order total, in basis points (250 = 2.5%):
# the customer pays it on top, the merchant owes it on completion.
FEE_CUSTOMER_BPS=250
FEE_MERCHANT_BPS=250
# How long a customer has to pay an order.
PAYMENT_WINDOW=15m
# This API's public address; shown to merchants as the callback URL for their gateway.
PUBLIC_BASE_URL=https://api.example.com
# Where gateways send customers after paying (an app deep link). Optional.
PAYMENT_RETURN_URL=

METRICS_ENABLED=true
