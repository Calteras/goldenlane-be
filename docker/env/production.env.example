# Non-secret settings of the production stage. Copy to .env.production (ignored by git):
#   cp docker/env/production.env.example .env.production
# Secrets are NOT here: they live in the two files below (sh scripts/new-secrets.sh production).

# Immutable release images from CI: the tag you already verified on staging.
APP_IMAGE=registry.example.com/group/streetfood-customer-api/api:0123456789ab
MIGRATION_IMAGE=registry.example.com/group/streetfood-customer-api/migrate:0123456789ab

# Docker secret files (dotenv). Keep them outside the web root, mode 400, owner uid 1000 on Linux.
APP_SECRETS_PATH=./secrets/production/app.env
MIGRATION_SECRETS_PATH=./secrets/production/migration.env

# Where the API listens on the host; put a TLS proxy in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=18080

LOG_LEVEL=info
HTTP_CORS_ALLOW_ORIGINS=https://app.example.com
FIREBASE_PROJECT_ID=your-production-firebase-project
POS_ALLOWED_HOSTS=pos.example.com
PUBLIC_BASE_URL=https://api.example.com
PG_POOL_MAX=10

# Optional: APP_MEMORY_LIMIT, APP_CPUS, FEE_CUSTOMER_BPS, FEE_MERCHANT_BPS, PAYMENT_WINDOW,
# INTEGRATION_WORKER_INTERVAL, INTEGRATION_RECONCILE_INTERVAL, METRICS_ENABLED.
