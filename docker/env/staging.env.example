# Non-secret settings of the staging stage. Copy to .env.staging (ignored by git):
#   cp docker/env/staging.env.example .env.staging
# Secrets are NOT here: they live in the two files below (sh scripts/new-secrets.sh staging).

# Immutable release images you pushed (README, "Build and push the release images") (the same tag goes to production later).
APP_IMAGE=dolanddev/streetfood-api:0123456789ab
MIGRATION_IMAGE=dolanddev/streetfood-migrate:0123456789ab

# Docker secret files (dotenv). Keep them outside the web root, mode 400, owner uid 1000 on Linux.
APP_SECRETS_PATH=./secrets/staging/app.env
MIGRATION_SECRETS_PATH=./secrets/staging/migration.env

# Where the API listens on the host; put a TLS proxy in front of it.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=18080

LOG_LEVEL=debug
HTTP_CORS_ALLOW_ORIGINS=https://staging-app.example.com
FIREBASE_PROJECT_ID=your-staging-firebase-project
POS_ALLOWED_HOSTS=pos-staging.example.com
PUBLIC_BASE_URL=https://api-staging.example.com
PG_POOL_MAX=10

# Optional: APP_MEMORY_LIMIT, APP_CPUS, FEE_CUSTOMER_BPS, FEE_MERCHANT_BPS, PAYMENT_WINDOW,
# WORKER_SWEEP_INTERVAL, INTEGRATION_RECONCILE_INTERVAL, METRICS_ENABLED.
